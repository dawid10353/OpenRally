{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "dist/**",
    "dist-ssr/**",
    "node_modules/**",
    ".vite/**",
    ".agents/**",
    "coverage/**"
  ],
  "plugins": [
    "react",
    "typescript"
  ],
  "rules": {
    "no-unused-vars": "warn"
  }
}
